# ===== CloudBase 配置（选项 A：连接真实后端）=====
# CloudBase 环境 ID
# 获取位置：CloudBase 控制台 → 环境 → 环境设置 → 环境 ID
VITE_CLOUDBASE_ENV_ID=your-cloudbase-env-id

# 地域（如 ap-shanghai / ap-guangzhou）
VITE_CLOUDBASE_REGION=ap-shanghai

# Publishable Key（前端匿名密钥，可安全暴露在前端）
# 获取位置：CloudBase 控制台 → 环境 → 身份认证 → 登录授权 → Publishable Key
VITE_CLOUDBASE_PUBLISHABLE_KEY=your-publishable-key

# ===== 演示模式（选项 C：无需后端，纯前端体验）=====
# 设置为 true 时，跳过 CloudBase 初始化与登录守卫，直接使用内置示例数据
# 适合快速预览界面与交互
VITE_DEMO_MODE=false
